# 仓配自助问数 LogiQL 环境变量模板
# 使用方式：cp .env.example .env（Windows: copy），然后填入实际值
# ⚠️ .env 已在 .gitignore 中排除，请勿提交

# ===== LLM（OpenAI 兼容端点，默认阿里云百炼 DashScope）=====
LLM_MODEL_NAME=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=请填入你的 API Key

# ===== MySQL =====
# 同时承载元数据库 meta（表/字段/指标元数据）与数据仓库 dw（业务数据）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=zhishu
MYSQL_PASSWORD=请填入 MySQL 密码（应用连接用）
MYSQL_ROOT_PASSWORD=请填入 MySQL root 密码（容器初始化用）

# ===== Qdrant（向量库：字段与指标的语义召回）=====
QDRANT_HOST=localhost
QDRANT_PORT=6333
EMBEDDING_SIZE=1024

# ===== Elasticsearch（全文检索：维度取值匹配）=====
ES_HOST=localhost
ES_PORT=9200
ES_INDEX_NAME=zhishu_values

# ===== Embedding 服务（TEI）=====
EMBEDDING_HOST=localhost
EMBEDDING_PORT=8081
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# docker-compose 中 TEI 容器拉取的模型 ID（挂载本地模型时改为 /models/xxx）
EMBEDDING_MODEL_ID=BAAI/bge-large-zh-v1.5
